// TaskFlow schema — visual model for https://dbdiagram.io
//
// SOURCE OF TRUTH: the SQLAlchemy ORM models in backend/app/database/models/.
// The schema is created by the app on startup (Base.metadata.create_all) and
// seeded by app/seed.py — there are no raw SQL setup scripts. This file is
// documentation only; keep it in sync with the models by hand.
//
// Authorization design: docs/specs/authorization-data-model.md

Table users {
  id uuid [pk]
  email varchar(255) [unique, not null]
  name varchar(255)
  avatar varchar(500)
  created_at timestamptz
  updated_at timestamptz
}

Table user_identities {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  provider varchar(50) [not null, note: "'password', 'google', 'github'"]
  provider_id varchar(255) [not null, note: "email for password, sub/id for OAuth"]
  password_hash varchar(255) [note: "only set when provider = 'password'"]
  created_at timestamptz
  updated_at timestamptz
}

Table boards {
  id uuid [pk]
  name varchar(255) [not null]
  description text
  created_at timestamptz
  updated_at timestamptz
  // No owner_id: ownership is a board_members row with role='owner' — the
  // single source of truth for access (spec Decision 1).
}

Table board_members {
  id uuid [pk]
  board_id uuid [not null, ref: > boards.id]
  user_id uuid [not null, ref: > users.id]
  role varchar(20) [not null, default: 'member', note: "CHECK: 'owner' | 'admin' | 'member' | 'viewer'"]
  created_at timestamptz

  indexes {
    (board_id, user_id) [unique, name: 'uq_board_members_user_board']
    // Partial unique index (not expressible in DBML): UNIQUE (board_id)
    // WHERE role = 'owner' — enforces at most one owner per board.
    board_id [name: 'one_owner_per_board', note: 'partial unique WHERE role=owner']
  }
}

Table columns {
  id uuid [pk]
  board_id uuid [not null, ref: > boards.id]
  name varchar(255) [not null]
  position integer [not null]
  created_at timestamptz
  updated_at timestamptz
}

Table tickets {
  id uuid [pk]
  board_id uuid [not null, ref: > boards.id]
  column_id uuid [not null, ref: > columns.id]
  title varchar(500) [not null]
  description text
  position integer [not null]
  priority varchar(50) [default: 'medium', note: "'low', 'medium', 'high'"]
  assignee_id uuid [ref: > users.id]
  creator_id uuid [not null, ref: > users.id]
  due_date timestamptz
  created_at timestamptz
  updated_at timestamptz
  // PLANNED (spec §11, not yet implemented): completed_at timestamptz,
  // completed_by uuid ref users.id — powers the board progress bar.
}

Table comments {
  id uuid [pk]
  ticket_id uuid [not null, ref: > tickets.id]
  user_id uuid [not null, ref: > users.id]
  content text [not null]
  created_at timestamptz
  updated_at timestamptz
}
