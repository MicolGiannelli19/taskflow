POSTGRES_USER = 
POSTGRES_PASSWORD = 
POSTGRES_DB = 

# Clerk authentication.
# Get these by running, in frontend/:
#   npx clerk@latest auth login
#   npx clerk@latest env pull
# The publishable key is public; the secret key must never reach the browser.
VITE_CLERK_PUBLISHABLE_KEY = 
CLERK_SECRET_KEY = 

# Password for the demo users (alice/bob/carol@example.com). Only used when the
# database is first seeded. Make it random — Clerk rejects passwords found in
# data breaches, so `password123` fails. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
SEED_PASSWORD = 

# Signs Clerk webhook deliveries. Copy it from the webhook endpoint you create
# in the Clerk Dashboard. Without it, POST /api/webhooks/clerk refuses every
# delivery — unconfigured must not mean unverified.
CLERK_WEBHOOK_SIGNING_SECRET = 

# Deployment origins, comma-separated. Both default to http://localhost:5173,
# so local development needs neither.
#   CLERK_AUTHORIZED_PARTIES — origins allowed to present a token (the `azp`
#   check). Never set this to `*`: it is what stops a token minted for another
#   Clerk application being replayed against this API.
#   CORS_ALLOWED_ORIGINS — browser origins allowed to call the API.
# CLERK_AUTHORIZED_PARTIES = https://taskflow.example
# CORS_ALLOWED_ORIGINS = https://taskflow.example

# Content-Security-Policy for the app page: `report` (default) logs violations
# without blocking; `enforce` blocks them. See docs/backend/auth.md.
# VITE_CSP_MODE = report 
